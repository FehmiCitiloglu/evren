# Optional legacy environment configuration. No .env file is required.
# Run evren or evren-agent to enter and save your key in the OS credential store.
# Use evren login to replace a saved key. Environment values take precedence.
# EVREN API Credentials
# Direct EVREN endpoint: https://evren-llmapi.ssyz.org.tr/v1
# Select the LLM Çıkarım key type in the portal (Platform keys are separate).
EVREN_API_KEY=evren_llm_your_key_here
# Optional direct CLI override:
# EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1

# LLMTR Gateway Credentials
# LLMTR endpoint: https://llmtr.com/v1
LLMTR_API_KEY=llmtr-your_key_here

# Optional: Other providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
